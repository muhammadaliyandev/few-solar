# FEW Solar API — environment
# Local:  cp .env.example .env  and fill in. Kabhi asal .env GitHub par nahi jata.

# PostgreSQL connection (Wasmer managed Postgres deploy par khud inject hota hai)
DATABASE_URL=postgresql://user:password@localhost:5432/few_solar
# Remote/managed Postgres ke liye SSL chahiye ho to true kar do
DATABASE_SSL=false

# Admin panel ki chabi — leads dekhne/badlane ke liye yahi key lagegi (lambi random rakho)
ADMIN_KEY=change-me-to-a-long-random-secret

PORT=3000
